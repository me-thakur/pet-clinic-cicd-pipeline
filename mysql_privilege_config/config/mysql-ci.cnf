# MySQL Configuration File for CI/CD Docker Container
# This file is mounted into the Docker container at /etc/mysql/conf.d/
# Requirements: 1.4, 2.2

[mysqld]
# Server identification
server-id = 1

# Binary logging configuration (required for replication testing)
log-bin = mysql-bin
binlog_format = ROW
binlog_expire_logs_seconds = 604800  # 7 days

# CRITICAL: Allow function creation without SUPER privileges
# This resolves ERROR 1419 in CI/CD pipelines
log_bin_trust_function_creators = 1

# Character set configuration
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# InnoDB configuration for CI performance
innodb_buffer_pool_size = 512M
innodb_log_file_size = 128M
innodb_flush_log_at_trx_commit = 1  # ACID compliance for testing
innodb_file_per_table = 1

# Connection and timeout settings
max_connections = 300
max_user_connections = 280
wait_timeout = 3600
interactive_timeout = 3600
connect_timeout = 10

# SQL mode (strict for testing)
sql_mode = "STRICT_TRANS_TABLES,ERROR_FOR_DIVISION_BY_ZERO,NO_AUTO_CREATE_USER,NO_ENGINE_SUBSTITUTION"

# Query cache (disabled in MySQL 8.0+, kept for 5.7 compatibility)
# query_cache_type = 0
# query_cache_size = 0

# Security settings for CI
# Disable local file loading for security
local_infile = 0

# Disable symbolic links
symbolic_links = 0

# Performance schema for monitoring
performance_schema = ON
performance_schema_max_table_instances = 400
performance_schema_max_table_handles = 4000

# Logging configuration
general_log = 1
general_log_file = /var/log/mysql/general.log
slow_query_log = 1
slow_query_log_file = /var/log/mysql/slow.log
long_query_time = 1.0

# Error logging
log_error = /var/log/mysql/error.log
log_error_verbosity = 2

# Replication settings (for testing replication scenarios)
gtid_mode = ON
enforce_gtid_consistency = ON
log_slave_updates = ON

# Memory settings optimized for CI containers
table_open_cache = 2000
table_definition_cache = 1400
thread_cache_size = 8
tmp_table_size = 64M
max_heap_table_size = 64M

# Network settings
bind_address = 0.0.0.0  # Allow connections from other containers
port = 3306

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4

# CI/CD Configuration Notes:
# 1. log_bin_trust_function_creators = 1 is the key setting for resolving privilege issues
# 2. Strict SQL mode ensures tests catch potential production issues
# 3. GTID mode enabled for advanced replication testing
# 4. Performance settings balanced for CI container resources
# 5. Security settings appropriate for isolated CI environment
# 6. Logging enabled for debugging CI failures
#!/usr/bin/env groovy
/**
 * Jenkins Pipeline for Pet Clinic Frontend Application
 * 
 * This pipeline handles the complete CI/CD process for the frontend application:
 * - Source code checkout
 * - Build and test
 * - Quality analysis
 * - Security scanning
 * - Deployment to staging/production
 * - Health checks and rollback
 * 
 * Requirements: 1.1, 4.3, 6.1, 6.2, 6.3
 */

pipeline {
    agent any
    
    // Pipeline options
    options {
        buildDiscarder(logRotator(numToKeepStr: '10', daysToKeepStr: '30'))
        timeout(time: 30, unit: 'MINUTES')
        timestamps()
        skipDefaultCheckout()
        parallelsAlwaysFailFast()
    }
    
    // Environment variables
    environment {
        // Application configuration
        APP_NAME = 'pet-clinic-frontend'
        APP_VERSION = "${env.BUILD_NUMBER}"
        MAVEN_OPTS = '-Xmx1024m -Xms512m'
        JAVA_HOME = '/usr/lib/jvm/java-11-amazon-corretto'
        
        // AWS configuration
        AWS_DEFAULT_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = credentials('aws-account-id')
        
        // Backend service configuration
        BACKEND_SERVICE_URL = credentials('backend-service-url')
        
        // Deployment configuration
        STAGING_ASG = 'dev-petclinic-frontend-asg'
        PROD_ASG = 'prod-petclinic-frontend-asg'
        STAGING_ALB_TG = 'dev-petclinic-frontend-tg'
        PROD_ALB_TG = 'prod-petclinic-frontend-tg'
        
        // Notification configuration
        SLACK_CHANNEL = '#ci-cd'
        EMAIL_RECIPIENTS = 'admin@petclinic.local'
    }
    
    // Build parameters
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'staging', 'prod'],
            description: 'Target deployment environment'
        )
        booleanParam(
            name: 'SKIP_TESTS',
            defaultValue: false,
            description: 'Skip unit and integration tests'
        )
        booleanParam(
            name: 'DEPLOY_ONLY',
            defaultValue: false,
            description: 'Skip build and deploy existing artifact'
        )
        string(
            name: 'ARTIFACT_VERSION',
            defaultValue: '',
            description: 'Specific artifact version to deploy (for DEPLOY_ONLY)'
        )
        booleanParam(
            name: 'BLUE_GREEN_DEPLOYMENT',
            defaultValue: false,
            description: 'Use blue-green deployment strategy'
        )
    }
    
    // Pipeline stages
    stages {
        stage('Checkout') {
            when {
                not { params.DEPLOY_ONLY }
            }
            steps {
                script {
                    // Clean workspace
                    cleanWs()
                    
                    // Checkout source code
                    checkout scm
                    
                    // Set build display name
                    currentBuild.displayName = "#${BUILD_NUMBER} - ${params.ENVIRONMENT}"
                    currentBuild.description = "Frontend deployment to ${params.ENVIRONMENT}"
                    
                    // Store commit info
                    env.GIT_COMMIT_SHORT = sh(
                        script: 'git rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                    
                    env.GIT_BRANCH_NAME = sh(
                        script: 'git rev-parse --abbrev-ref HEAD',
                        returnStdout: true
                    ).trim()
                }
            }
            post {
                success {
                    echo "✓ Source code checked out successfully"
                }
                failure {
                    error "✗ Failed to checkout source code"
                }
            }
        }
        
        stage('Build') {
            when {
                not { params.DEPLOY_ONLY }
            }
            steps {
                script {
                    echo "Building Pet Clinic Frontend..."
                    
                    // Maven build
                    sh '''
                        cd pet-clinic-frontend
                        mvn clean compile -DskipTests=true \
                            -Dmaven.repo.local=/opt/maven-repo \
                            -B -V
                    '''
                    
                    // Store build info
                    env.BUILD_TIMESTAMP = sh(
                        script: 'date +"%Y%m%d-%H%M%S"',
                        returnStdout: true
                    ).trim()
                }
            }
            post {
                success {
                    echo "✓ Build completed successfully"
                }
                failure {
                    error "✗ Build failed"
                }
            }
        }
        
        stage('Test') {
            when {
                allOf {
                    not { params.DEPLOY_ONLY }
                    not { params.SKIP_TESTS }
                }
            }
            parallel {
                stage('Unit Tests') {
                    steps {
                        script {
                            echo "Running unit tests..."
                            sh '''
                                cd pet-clinic-frontend
                                mvn test \
                                    -Dmaven.repo.local=/opt/maven-repo \
                                    -Dspring.profiles.active=test \
                                    -B
                            '''
                        }
                    }
                    post {
                        always {
                            // Publish test results
                            publishTestResults testResultsPattern: 'pet-clinic-frontend/target/surefire-reports/*.xml'
                            
                            // Publish coverage report
                            publishCoverage adapters: [
                                jacocoAdapter('pet-clinic-frontend/target/site/jacoco/jacoco.xml')
                            ], sourceFileResolver: sourceFiles('STORE_LAST_BUILD')
                        }
                    }
                }
                
                stage('Integration Tests') {
                    steps {
                        script {
                            echo "Running integration tests..."
                            sh '''
                                cd pet-clinic-frontend
                                mvn verify -DskipUnitTests=true \
                                    -Dmaven.repo.local=/opt/maven-repo \
                                    -Dspring.profiles.active=test \
                                    -Dbackend.service.url=${BACKEND_SERVICE_URL} \
                                    -B
                            '''
                        }
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'pet-clinic-frontend/target/failsafe-reports/*.xml'
                        }
                    }
                }
                
                stage('Security Tests') {
                    steps {
                        script {
                            echo "Running security tests..."
                            sh '''
                                cd pet-clinic-frontend
                                mvn test -Dtest="*Security*" \
                                    -Dmaven.repo.local=/opt/maven-repo \
                                    -Dspring.profiles.active=test \
                                    -B
                            '''
                        }
                    }
                    post {
                        always {
                            publishTestResults testResultsPattern: 'pet-clinic-frontend/target/surefire-reports/*Security*.xml'
                        }
                    }
                }
            }
            post {
                success {
                    echo "✓ All tests passed"
                }
                failure {
                    error "✗ Tests failed"
                }
            }
        }
        
        stage('Quality Analysis') {
            when {
                not { params.DEPLOY_ONLY }
            }
            parallel {
                stage('SonarQube Analysis') {
                    steps {
                        script {
                            echo "Running SonarQube analysis..."
                            withSonarQubeEnv('SonarQube') {
                                sh '''
                                    cd pet-clinic-frontend
                                    mvn sonar:sonar \
                                        -Dsonar.projectKey=pet-clinic-frontend \
                                        -Dsonar.projectName="Pet Clinic Frontend" \
                                        -Dsonar.projectVersion=${BUILD_NUMBER} \
                                        -Dsonar.sources=src/main/java,src/main/resources/templates \
                                        -Dsonar.tests=src/test/java \
                                        -Dsonar.java.coveragePlugin=jacoco \
                                        -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml \
                                        -B
                                '''
                            }
                        }
                    }
                }
                
                stage('Security Scan') {
                    steps {
                        script {
                            echo "Running security scan..."
                            sh '''
                                cd pet-clinic-frontend
                                # OWASP Dependency Check
                                mvn org.owasp:dependency-check-maven:check \
                                    -DfailBuildOnCVSS=7 \
                                    -B
                            '''
                        }
                    }
                    post {
                        always {
                            publishHTML([
                                allowMissing: false,
                                alwaysLinkToLastBuild: true,
                                keepAll: true,
                                reportDir: 'pet-clinic-frontend/target',
                                reportFiles: 'dependency-check-report.html',
                                reportName: 'OWASP Dependency Check Report'
                            ])
                        }
                    }
                }
                
                stage('Template Validation') {
                    steps {
                        script {
                            echo "Validating Thymeleaf templates..."
                            sh '''
                                cd pet-clinic-frontend
                                # Check for template syntax errors
                                find src/main/resources/templates -name "*.html" -exec echo "Checking {}" \\;
                                
                                # Validate HTML structure (basic check)
                                for template in src/main/resources/templates/**/*.html; do
                                    if [ -f "$template" ]; then
                                        echo "Validating $template"
                                        # Basic HTML validation - check for unclosed tags
                                        python3 -c "
import sys
import re
with open('$template', 'r') as f:
    content = f.read()
    # Basic check for matching tags
    if content.count('<') != content.count('>'):
        print('WARNING: Mismatched angle brackets in $template')
        sys.exit(1)
print('Template validation passed')
"
                                    fi
                                done
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Package') {
            when {
                not { params.DEPLOY_ONLY }
            }
            steps {
                script {
                    echo "Packaging application..."
                    
                    // Create JAR file
                    sh '''
                        cd pet-clinic-frontend
                        mvn package -DskipTests=true \
                            -Dmaven.repo.local=/opt/maven-repo \
                            -Dspring.profiles.active=${ENVIRONMENT} \
                            -Dbackend.service.url=${BACKEND_SERVICE_URL} \
                            -B
                    '''
                    
                    // Create deployment package
                    sh '''
                        mkdir -p dist
                        cp pet-clinic-frontend/target/*.jar dist/
                        cp efs-scripts/deploy-app.sh dist/
                        cp efs-scripts/health-check.sh dist/
                        
                        # Create version info
                        cat > dist/version.txt << EOF
Build Number: ${BUILD_NUMBER}
Git Commit: ${GIT_COMMIT_SHORT}
Git Branch: ${GIT_BRANCH_NAME}
Build Timestamp: ${BUILD_TIMESTAMP}
Environment: ${ENVIRONMENT}
Backend Service URL: ${BACKEND_SERVICE_URL}
EOF
                    '''
                    
                    // Archive artifacts
                    archiveArtifacts artifacts: 'dist/**/*', fingerprint: true
                }
            }
            post {
                success {
                    echo "✓ Application packaged successfully"
                }
                failure {
                    error "✗ Packaging failed"
                }
            }
        }
        
        stage('Deploy') {
            steps {
                script {
                    echo "Deploying to ${params.ENVIRONMENT} environment..."
                    
                    // Determine target resources
                    def targetASG = params.ENVIRONMENT == 'prod' ? env.PROD_ASG : env.STAGING_ASG
                    def targetTG = params.ENVIRONMENT == 'prod' ? env.PROD_ALB_TG : env.STAGING_ALB_TG
                    
                    // Get artifact version
                    def artifactVersion = params.DEPLOY_ONLY ? params.ARTIFACT_VERSION : env.BUILD_NUMBER
                    
                    if (params.BLUE_GREEN_DEPLOYMENT) {
                        // Blue-Green deployment
                        echo "Performing blue-green deployment..."
                        
                        sh """
                            # Create new launch template version
                            CURRENT_LT=\$(aws autoscaling describe-auto-scaling-groups \\
                                --auto-scaling-group-names ${targetASG} \\
                                --query 'AutoScalingGroups[0].LaunchTemplate.LaunchTemplateName' \\
                                --output text)
                            
                            # Update user data with new artifact version
                            aws ec2 create-launch-template-version \\
                                --launch-template-name \$CURRENT_LT \\
                                --source-version '\$Latest' \\
                                --launch-template-data '{
                                    "UserData": "'$(echo "#!/bin/bash
cd /tmp
aws s3 cp s3://petclinic-deployments/${params.ENVIRONMENT}/frontend/${artifactVersion}/ . --recursive
chmod +x deploy-app.sh
./deploy-app.sh frontend *.jar ${params.ENVIRONMENT}" | base64 -w 0)'"
                                }'
                            
                            # Update ASG to use new launch template version
                            aws autoscaling update-auto-scaling-group \\
                                --auto-scaling-group-name ${targetASG} \\
                                --launch-template LaunchTemplateName=\$CURRENT_LT,Version='\$Latest'
                            
                            # Trigger instance refresh
                            aws autoscaling start-instance-refresh \\
                                --auto-scaling-group-name ${targetASG} \\
                                --preferences MinHealthyPercentage=50,InstanceWarmup=300
                        """
                    } else {
                        // Rolling deployment
                        echo "Performing rolling deployment..."
                        
                        sh """
                            # Get ASG instances
                            INSTANCES=\$(aws autoscaling describe-auto-scaling-groups \\
                                --auto-scaling-group-names ${targetASG} \\
                                --query 'AutoScalingGroups[0].Instances[?LifecycleState==\`InService\`].InstanceId' \\
                                --output text)
                            
                            echo "Deploying to instances: \$INSTANCES"
                            
                            # Upload deployment package to S3
                            aws s3 cp dist/ s3://petclinic-deployments/${params.ENVIRONMENT}/frontend/${artifactVersion}/ --recursive
                            
                            # Deploy to each instance
                            for INSTANCE_ID in \$INSTANCES; do
                                echo "Deploying to instance: \$INSTANCE_ID"
                                
                                # Remove instance from target group
                                aws elbv2 deregister-targets \\
                                    --target-group-arn ${targetTG} \\
                                    --targets Id=\$INSTANCE_ID
                                
                                # Wait for deregistration
                                sleep 30
                                
                                # Execute deployment on instance
                                aws ssm send-command \\
                                    --instance-ids \$INSTANCE_ID \\
                                    --document-name "AWS-RunShellScript" \\
                                    --parameters 'commands=[
                                        "cd /tmp",
                                        "aws s3 cp s3://petclinic-deployments/${params.ENVIRONMENT}/frontend/${artifactVersion}/ . --recursive",
                                        "chmod +x deploy-app.sh",
                                        "./deploy-app.sh frontend *.jar ${params.ENVIRONMENT}"
                                    ]' \\
                                    --output text
                                
                                # Wait for deployment
                                sleep 60
                                
                                # Re-register instance with target group
                                aws elbv2 register-targets \\
                                    --target-group-arn ${targetTG} \\
                                    --targets Id=\$INSTANCE_ID
                                
                                # Wait for health check
                                sleep 30
                            done
                        """
                    }
                }
            }
            post {
                success {
                    echo "✓ Deployment completed successfully"
                }
                failure {
                    error "✗ Deployment failed"
                }
            }
        }
        
        stage('Health Check') {
            steps {
                script {
                    echo "Performing health checks..."
                    
                    // Wait for deployment to complete
                    sleep(time: 60, unit: 'SECONDS')
                    
                    // Get target resources
                    def targetASG = params.ENVIRONMENT == 'prod' ? env.PROD_ASG : env.STAGING_ASG
                    def targetTG = params.ENVIRONMENT == 'prod' ? env.PROD_ALB_TG : env.STAGING_ALB_TG
                    
                    // Perform health checks
                    sh """
                        # Check target group health
                        HEALTHY_TARGETS=\$(aws elbv2 describe-target-health \\
                            --target-group-arn ${targetTG} \\
                            --query 'TargetHealthDescriptions[?TargetHealth.State==\`healthy\`]' \\
                            --output json | jq length)
                        
                        TOTAL_TARGETS=\$(aws elbv2 describe-target-health \\
                            --target-group-arn ${targetTG} \\
                            --query 'TargetHealthDescriptions' \\
                            --output json | jq length)
                        
                        echo "Healthy targets: \$HEALTHY_TARGETS / \$TOTAL_TARGETS"
                        
                        if [ "\$HEALTHY_TARGETS" -eq 0 ]; then
                            echo "No healthy targets found"
                            exit 1
                        fi
                        
                        # Get ALB DNS name
                        ALB_DNS=\$(aws elbv2 describe-load-balancers \\
                            --query 'LoadBalancers[0].DNSName' \\
                            --output text)
                        
                        # Test application endpoints
                        echo "Testing application health endpoint..."
                        curl -f "http://\$ALB_DNS/actuator/health" || exit 1
                        
                        echo "Testing login page..."
                        curl -f "http://\$ALB_DNS/login" || exit 1
                        
                        echo "All health checks passed"
                    """
                }
            }
            post {
                failure {
                    script {
                        echo "Health checks failed - initiating rollback..."
                        // Rollback logic would go here
                        currentBuild.result = 'FAILURE'
                    }
                }
            }
        }
        
        stage('Smoke Tests') {
            steps {
                script {
                    echo "Running smoke tests..."
                    
                    sh """
                        # Get ALB DNS name
                        ALB_DNS=\$(aws elbv2 describe-load-balancers \\
                            --query 'LoadBalancers[0].DNSName' \\
                            --output text)
                        
                        # Test critical user journeys
                        echo "Testing user authentication flow..."
                        
                        # Test login page accessibility
                        curl -f "http://\$ALB_DNS/login" > /dev/null
                        
                        # Test static resources
                        curl -f "http://\$ALB_DNS/webjars/bootstrap/css/bootstrap.min.css" > /dev/null
                        
                        # Test API connectivity (if backend is available)
                        if curl -f "${BACKEND_SERVICE_URL}/actuator/health" > /dev/null 2>&1; then
                            echo "Backend service is available"
                        else
                            echo "WARNING: Backend service not available for integration testing"
                        fi
                        
                        echo "Smoke tests completed successfully"
                    """
                }
            }
        }
    }
    
    // Post-build actions
    post {
        always {
            script {
                // Clean workspace
                cleanWs()
                
                // Calculate build duration
                def duration = currentBuild.durationString.replace(' and counting', '')
                
                // Set build description
                currentBuild.description = """
                    Environment: ${params.ENVIRONMENT}
                    Duration: ${duration}
                    Commit: ${env.GIT_COMMIT_SHORT ?: 'N/A'}
                    Branch: ${env.GIT_BRANCH_NAME ?: 'N/A'}
                    Deployment: ${params.BLUE_GREEN_DEPLOYMENT ? 'Blue-Green' : 'Rolling'}
                """.stripIndent()
            }
        }
        
        success {
            script {
                echo "✓ Pipeline completed successfully"
                
                // Send success notification
                slackSend(
                    channel: env.SLACK_CHANNEL,
                    color: 'good',
                    message: """
                        ✅ *Pet Clinic Frontend Deployment Successful*
                        
                        *Environment:* ${params.ENVIRONMENT}
                        *Build:* #${BUILD_NUMBER}
                        *Commit:* ${env.GIT_COMMIT_SHORT ?: 'N/A'}
                        *Branch:* ${env.GIT_BRANCH_NAME ?: 'N/A'}
                        *Duration:* ${currentBuild.durationString.replace(' and counting', '')}
                        *Deployment:* ${params.BLUE_GREEN_DEPLOYMENT ? 'Blue-Green' : 'Rolling'}
                        
                        <${BUILD_URL}|View Build>
                    """.stripIndent()
                )
                
                // Send email notification
                emailext(
                    to: env.EMAIL_RECIPIENTS,
                    subject: "✅ Pet Clinic Frontend Deployment Successful - ${params.ENVIRONMENT}",
                    body: """
                        <h2>Pet Clinic Frontend Deployment Successful</h2>
                        <p><strong>Environment:</strong> ${params.ENVIRONMENT}</p>
                        <p><strong>Build Number:</strong> #${BUILD_NUMBER}</p>
                        <p><strong>Git Commit:</strong> ${env.GIT_COMMIT_SHORT ?: 'N/A'}</p>
                        <p><strong>Git Branch:</strong> ${env.GIT_BRANCH_NAME ?: 'N/A'}</p>
                        <p><strong>Duration:</strong> ${currentBuild.durationString.replace(' and counting', '')}</p>
                        <p><strong>Deployment Strategy:</strong> ${params.BLUE_GREEN_DEPLOYMENT ? 'Blue-Green' : 'Rolling'}</p>
                        <p><a href="${BUILD_URL}">View Build Details</a></p>
                    """,
                    mimeType: 'text/html'
                )
            }
        }
        
        failure {
            script {
                echo "✗ Pipeline failed"
                
                // Send failure notification
                slackSend(
                    channel: env.SLACK_CHANNEL,
                    color: 'danger',
                    message: """
                        ❌ *Pet Clinic Frontend Deployment Failed*
                        
                        *Environment:* ${params.ENVIRONMENT}
                        *Build:* #${BUILD_NUMBER}
                        *Commit:* ${env.GIT_COMMIT_SHORT ?: 'N/A'}
                        *Branch:* ${env.GIT_BRANCH_NAME ?: 'N/A'}
                        *Duration:* ${currentBuild.durationString.replace(' and counting', '')}
                        
                        <${BUILD_URL}|View Build> | <${BUILD_URL}console|View Logs>
                    """.stripIndent()
                )
                
                // Send email notification
                emailext(
                    to: env.EMAIL_RECIPIENTS,
                    subject: "❌ Pet Clinic Frontend Deployment Failed - ${params.ENVIRONMENT}",
                    body: """
                        <h2>Pet Clinic Frontend Deployment Failed</h2>
                        <p><strong>Environment:</strong> ${params.ENVIRONMENT}</p>
                        <p><strong>Build Number:</strong> #${BUILD_NUMBER}</p>
                        <p><strong>Git Commit:</strong> ${env.GIT_COMMIT_SHORT ?: 'N/A'}</p>
                        <p><strong>Git Branch:</strong> ${env.GIT_BRANCH_NAME ?: 'N/A'}</p>
                        <p><strong>Duration:</strong> ${currentBuild.durationString.replace(' and counting', '')}</p>
                        <p><a href="${BUILD_URL}">View Build Details</a> | <a href="${BUILD_URL}console">View Console Logs</a></p>
                    """,
                    mimeType: 'text/html'
                )
            }
        }
        
        unstable {
            script {
                echo "⚠ Pipeline completed with warnings"
                
                // Send warning notification
                slackSend(
                    channel: env.SLACK_CHANNEL,
                    color: 'warning',
                    message: """
                        ⚠️ *Pet Clinic Frontend Deployment Unstable*
                        
                        *Environment:* ${params.ENVIRONMENT}
                        *Build:* #${BUILD_NUMBER}
                        *Commit:* ${env.GIT_COMMIT_SHORT ?: 'N/A'}
                        *Branch:* ${env.GIT_BRANCH_NAME ?: 'N/A'}
                        *Duration:* ${currentBuild.durationString.replace(' and counting', '')}
                        
                        <${BUILD_URL}|View Build>
                    """.stripIndent()
                )
            }
        }
    }
}